{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product catalog item available on the store",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the product"
        },
        "title": {
          "type": "string",
          "description": "Product display name"
        },
        "subtitle": {
          "type": "string",
          "description": "Short description or subtitle"
        },
        "vipPrice": {
          "type": "string",
          "description": "VIP member price"
        },
        "regularPrice": {
          "type": "string",
          "description": "Regular non-member price"
        },
        "imageSrc": {
          "type": "string",
          "description": "Main image URL"
        },
        "thumbnails": {
          "type": "array",
          "description": "List of gallery image URLs"
        },
        "badge": {
          "type": "string",
          "description": "Promotional badge text"
        },
        "rating": {
          "type": "number",
          "description": "Product star rating"
        },
        "reviewCount": {
          "type": "string",
          "description": "Total review count"
        },
        "soldCount": {
          "type": "string",
          "description": "Number of items sold"
        },
        "salesBadge": {
          "type": "string",
          "description": "Sales highlight badge"
        },
        "shortDescription": {
          "type": "string",
          "description": "Overview description"
        },
        "highlights": {
          "type": "array",
          "description": "Feature highlights list"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "title", "vipPrice", "regularPrice", "imageSrc"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order identifier"
        },
        "customerName": {
          "type": "string",
          "description": "Recipient full name"
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number"
        },
        "address": {
          "type": "string",
          "description": "Delivery address"
        },
        "productName": {
          "type": "string",
          "description": "Purchased product name"
        },
        "variant": {
          "type": "string",
          "description": "Selected product variant"
        },
        "quantity": {
          "type": "number",
          "description": "Item quantity"
        },
        "totalPrice": {
          "type": "string",
          "description": "Total order amount"
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment status",
          "enum": ["Đang xử lý", "Đang giao", "Đã giao", "Đã hủy"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "customerName", "phone", "address", "totalPrice", "status"]
    },
    "Media": {
      "title": "Media",
      "description": "Uploaded media asset (image or video)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique media identifier"
        },
        "name": {
          "type": "string",
          "description": "Original file name"
        },
        "url": {
          "type": "string",
          "description": "Accessible media URL / path"
        },
        "type": {
          "type": "string",
          "description": "MIME type (e.g. image/jpeg, video/mp4)"
        },
        "mediaType": {
          "type": "string",
          "description": "image or video",
          "enum": ["image", "video"]
        },
        "size": {
          "type": "number",
          "description": "File size in bytes"
        },
        "createdAt": {
          "type": "string",
          "description": "Upload timestamp"
        }
      },
      "required": ["id", "name", "url", "mediaType"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of e-commerce store products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of store orders"
    },
    "/media/{mediaId}": {
      "schema": "Media",
      "description": "Collection of uploaded media assets"
    }
  }
}
