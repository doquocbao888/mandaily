rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: Readable by all customers, writeable by admin / manager
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: Creatable by customers, manageable by admin
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Media collection: Readable and writeable for media management
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Default catch-all deny for other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
